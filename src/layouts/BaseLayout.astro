---
import SEOHead from '../components/SEOHead.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../i18n/locales';
import type { AIEvent } from '../types';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  keywords: string;
  events?: AIEvent[];
  event?: AIEvent;
  path?: string;
}

const { lang, title, description, keywords, events, event, path } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead lang={lang} title={title} description={description} keywords={keywords} events={events} event={event} path={path} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
